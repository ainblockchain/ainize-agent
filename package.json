{
  "name": "@ainize/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ainize-agent": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@ainize/core": "github:ainblockchain/ainize-core",
    "@ainize/mcp": "github:ainblockchain/ainize-mcp",
    "chalk": "^5.6.2",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.23.13"
  },
  "description": "ainize-agent \u2014 autonomous buyer agent for the Ainize knowledge marketplace (automatic x402 payment, live load); `ngram-agent` alias kept",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
