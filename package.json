{
  "name": "@ainize/agent",
  "version": "0.2.1",
  "description": "ainize-agent — autonomous buyer agent for the Ainize knowledge marketplace (automatic x402 payment, live load); `ngram-agent` alias kept",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./teams": {
      "types": "./dist/teams/index.d.ts",
      "require": "./dist/teams/index.cjs",
      "import": "./dist/teams/index.js",
      "default": "./dist/teams/index.js"
    },
    "./research": {
      "types": "./dist/research/index.d.ts",
      "require": "./dist/research/index.cjs",
      "import": "./dist/research/index.js",
      "default": "./dist/research/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "ainize-agent": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@ainize/core": "github:ainblockchain/ainize-core",
    "@ainize/mcp": "github:ainblockchain/ainize-mcp",
    "chalk": "^5.6.2",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@ainize/node": "github:ainblockchain/ainize-node",
    "@types/node": "^24.10.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "typesVersions": {
    "*": {
      "teams": [
        "dist/teams/index.d.ts"
      ],
      "research": [
        "dist/research/index.d.ts"
      ]
    }
  }
}
